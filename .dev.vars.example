# Cloudflare local dev secrets — jangan commit, copy ke .dev.vars
# cp .dev.vars.example .dev.vars && isi dengan kredensial asli

# Supabase
# NEXT_PUBLIC_SUPABASE_URL=https://xxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Cloudflare R2
# R2_ACCESS_KEY_ID=xxx
# R2_SECRET_ACCESS_KEY=xxx
# R2_ENDPOINT=https://xxx.r2.cloudflarestorage.com
# R2_BUCKET_NAME=narehat-photos
# R2_PUBLIC_URL=https://photos.narehat.com

# AI
# SUMOPOD_API_KEY=xxx

# Payment — SumoPod
# SUMOPOD_PAYMENT_API_KEY=xxx
# SUMOPOD_PAYMENT_WEBHOOK_TOKEN=whtok_...
# SUMOPOD_PAYMENT_WEBHOOK_SECRET=whsec_...  (alternatif, lebih secure)
# SUMOPOD_PAYMENT_API_URL=https://api-pay-sandbox.sumopod.com/api/v1/payments  (sandbox, default)

# Public site URL
# NEXT_PUBLIC_APP_URL=https://narehat.com
# NEXT_PUBLIC_SITE_URL=https://narehat.com
